{
  "name": "anime-subtitle-studio",
  "version": "1.0.0",
  "description": "Local web UI for batch Japanese→English anime subtitle translation with whisper and an LLM",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --test test/pipeline.test.js",
    "screenshots": "node scripts/capture-screenshots.js"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "express": "^4.19.2",
    "ws": "^8.17.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "puppeteer-core": "^25.12.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
